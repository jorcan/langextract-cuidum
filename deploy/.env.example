# Plantilla de configuración del servicio (NO commitear valores reales).
# Copia a deploy/.env.local (este host) o deploy/.env (VPS) y rellena.

# Token que el cliente debe enviar en cabecera X-API-Key para /api/*
# Genera uno: python3 -c "import secrets; print(secrets.token_urlsafe(24))"
API_TOKEN=

# Clave OpenRouter (credentials.env local o la del VPS)
OPENROUTER_API_KEY=

# Conexión a n8n_odoo (resultados + cola HITL) — accesible desde este host y desde PROD-A
N8N_DB_URL=

# Conexión a Cuidum (candidatos) — SOLO accesible desde 141.94.92.173.
# En el VPS dejarla vacía (CUIDUM_DB_URL=) salvo que Cuidum abra el IP.
CUIDUM_DB_URL=

# Solo para el override traefik: host público
HOST_TRAEFIK=obs-langextract.tribbe.es